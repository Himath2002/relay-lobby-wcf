<Window
    x:Class="RelayLobby.Client.Duplex.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RelayLobby · Duplex client"
    Width="980"
    Height="640"
    MinWidth="760"
    MinHeight="520"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="48">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Width="430"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <TextBlock Style="{StaticResource EyebrowText}" Text="RELAYLOBBY" />
            <TextBlock
                Margin="0,12,0,14"
                FontSize="43"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="Distributed conversation, two ways."
                TextWrapping="Wrap" />
            <TextBlock
                Width="410"
                HorizontalAlignment="Left"
                FontSize="17"
                Foreground="{StaticResource TextSecondaryBrush}"
                LineHeight="27"
                Text="This client receives room-state updates through WCF callbacks—responsive delivery beside the interval-based polling client."
                TextWrapping="Wrap" />
            <StackPanel Margin="0,28,0,0" Orientation="Horizontal">
                <Border
                    Padding="10,6"
                    Background="#16352F"
                    CornerRadius="14">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentBrush}"
                        Text="DUPLEX MODE" />
                </Border>
                <TextBlock
                    Margin="12,5,0,0"
                    Style="{StaticResource MutedText}"
                    Text="Server-initiated room updates" />
            </StackPanel>
        </StackPanel>

        <Border
            Grid.Column="1"
            Width="350"
            Padding="34"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource HeadingText}"
                    Text="Join the lobby" />
                <TextBlock
                    Margin="0,8,0,28"
                    Style="{StaticResource MutedText}"
                    Text="Choose a display name for this session." />

                <TextBlock
                    Margin="0,0,0,8"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Display name" />
                <TextBox
                    x:Name="txtUsername"
                    Margin="0,0,0,18"
                    MaxLength="40" />
                <Button
                    Height="44"
                    Click="Login_Click"
                    Content="Connect"
                    Style="{StaticResource PrimaryButton}" />
                <Button
                    Margin="0,10,0,0"
                    Click="Exit_Click"
                    Content="Exit" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
