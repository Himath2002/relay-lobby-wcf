<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RelayLobby.Client.Polling</RootNamespace>
    <AssemblyName>RelayLobby.Client.Polling</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.ServiceModel" />
    <ProjectReference Include="../RelayLobby.Contracts/RelayLobby.Contracts.csproj" />
    <ProjectReference Include="../RelayLobby.Domain/RelayLobby.Domain.csproj" />
  </ItemGroup>
</Project>
